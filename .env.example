<?php
/**
 * .env.example - Environment Configuration Template
 * Скопіюйте у .env та заповніть значення
 */

# ==========================================
# DATABASE
# ==========================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=profspilka
DB_USER=root
DB_PASS=""

# ==========================================
# ENCRYPTION
# ==========================================
# Генерувати ключ: php -r 'echo bin2hex(random_bytes(32));'
ENCRYPTION_KEY="your-32-byte-key-as-hex-here"

# ==========================================
# ENVIRONMENT
# ==========================================
ENVIRONMENT=development
DEBUG=1

# ==========================================
# SECURITY
# ==========================================
AUTH_TRUST_PROXIES=false
AUTH_MAX_ATTEMPTS_PHONE=5
AUTH_MAX_ATTEMPTS_IP=20
AUTH_LOCKOUT_MINUTES=15
AUTH_LOG_RETENTION_DAYS=7

# ==========================================
# APPLICATION
# ==========================================
APP_NAME="ACTION: Профспілка"
APP_URL="https://profspilka.ua"
APP_TIMEZONE="Europe/Kyiv"

# ==========================================
# MONOBANK API (Optional)
# ==========================================
MONOBANK_TOKEN=""

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=error
LOG_PATH=./logs/error.log

# ==========================================
# SESSION
# ==========================================
SESSION_LIFETIME=2592000
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_HTTPONLY=1
SESSION_COOKIE_SAMESITE=Strict
